{
  "_comment": "Fontes de tendência rodadas via Apify a cada pesquisa (opcional, exige APIFY_TOKEN). 'format': google_trends | reddit | x | generic. Para desligar uma fonte: enabled false. O setup preenche os termos com o tema-macro; o Reddit fica desligado até você listar as comunidades do tema em startUrls (ex.: https://www.reddit.com/r/<comunidade>/top/?t=week).",
  "sources": [
    {
      "name": "Google Trends",
      "enabled": true,
      "actor": "apify/google-trends-scraper",
      "format": "google_trends",
      "input": {
        "searchTerms": [
          "__TEMA__"
        ],
        "timeRange": "now 7-d",
        "geo": "BR",
        "skipDebugScreen": true
      }
    },
    {
      "name": "Reddit",
      "enabled": false,
      "actor": "trudax/reddit-scraper-lite",
      "format": "reddit",
      "input": {
        "startUrls": [],
        "sort": "top",
        "time": "week",
        "maxItems": 40,
        "maxPostCount": 8,
        "skipComments": true,
        "skipUserPosts": true,
        "skipCommunity": true
      }
    },
    {
      "name": "X (Twitter)",
      "enabled": true,
      "actor": "apidojo/tweet-scraper",
      "format": "x",
      "input": {
        "searchTerms": [
          "\"__TEMA__\" min_faves:100 -filter:replies"
        ],
        "sort": "Top",
        "maxItems": 60
      }
    }
  ]
}
