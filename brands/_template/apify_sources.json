{
  "_comment": "Fontes de tendência rodadas via Apify a cada pesquisa. 'actor' usa o formato usuario/actor. 'format' define como o resultado vira sinal para o modelo: google_trends | reddit | x | generic. Para desligar uma fonte, use enabled: false.",
  "sources": [
    {
      "name": "Google Trends BR",
      "enabled": true,
      "actor": "apify/google-trends-scraper",
      "format": "google_trends",
      "input": {
        "searchTerms": [
          "marketing digital",
          "tráfego pago",
          "CRM"
        ],
        "timeRange": "now 7-d",
        "geo": "BR",
        "skipDebugScreen": true
      }
    },
    {
      "name": "Reddit (comunidades de marketing e vendas)",
      "enabled": true,
      "actor": "trudax/reddit-scraper-lite",
      "format": "reddit",
      "input": {
        "startUrls": [
          {
            "url": "https://www.reddit.com/r/marketing/top/?t=week"
          },
          {
            "url": "https://www.reddit.com/r/sales/top/?t=week"
          },
          {
            "url": "https://www.reddit.com/r/SaaS/top/?t=week"
          },
          {
            "url": "https://www.reddit.com/r/digital_marketing/top/?t=week"
          },
          {
            "url": "https://www.reddit.com/r/startups/top/?t=week"
          }
        ],
        "sort": "top",
        "time": "week",
        "maxItems": 40,
        "maxPostCount": 8,
        "skipComments": true,
        "skipUserPosts": true,
        "skipCommunity": true
      }
    },
    {
      "name": "X (Twitter)",
      "enabled": true,
      "actor": "apidojo/tweet-scraper",
      "format": "x",
      "input": {
        "searchTerms": [
          "(marketing OR \"B2B sales\" OR \"SaaS growth\") min_faves:500 -filter:replies",
          "(marketing OR vendas OR \"tráfego pago\") min_faves:200 lang:pt -filter:replies"
        ],
        "sort": "Top",
        "maxItems": 60
      }
    }
  ]
}
