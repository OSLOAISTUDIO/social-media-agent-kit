{
  "_comment": "Marca de exemplo: fontes do Apify desligadas (sem tema de conteúdo).",
  "sources": [
    {
      "name": "Google Trends",
      "enabled": false,
      "actor": "apify/google-trends-scraper",
      "format": "google_trends",
      "input": {
        "searchTerms": [
          "tema de exemplo"
        ],
        "timeRange": "now 7-d",
        "geo": "BR",
        "skipDebugScreen": true
      }
    },
    {
      "name": "Reddit",
      "enabled": false,
      "actor": "trudax/reddit-scraper-lite",
      "format": "reddit",
      "input": {
        "startUrls": [],
        "sort": "top",
        "time": "week",
        "maxItems": 40,
        "maxPostCount": 8,
        "skipComments": true,
        "skipUserPosts": true,
        "skipCommunity": true
      }
    },
    {
      "name": "X (Twitter)",
      "enabled": false,
      "actor": "apidojo/tweet-scraper",
      "format": "x",
      "input": {
        "searchTerms": [
          "\"tema de exemplo\" min_faves:100 -filter:replies"
        ],
        "sort": "Top",
        "maxItems": 60
      }
    }
  ]
}
