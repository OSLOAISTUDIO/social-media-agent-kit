<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>{{ brand_name }} | {{ slug }} | {{ 'Stories' if story else 'Carrossel' }}</title>
<!--
  Gerado pelo Agent de postagem a partir do padrão de _social/panorama-educacao-infantil-2026/pecas.html.
  Feed 1080 × 1350 (4:5) · Stories 1080 × 1920 (9:16, áreas seguras 250px topo e 320px base).
  Margem 96px · grid de 6 colunas (128px) com gutter 24px · nada girado · radius 0 · sem sombra ·
  separação por linha · peso 400 (500 só em botão e tag).
-->
<style>
{% if v.font_regular %}
@font-face { font-family: "{{ v.font_family }}"; src: url("{{ assets }}/{{ v.font_regular }}"); font-weight: 400; }
@font-face { font-family: "{{ v.font_family }}"; src: url("{{ assets }}/{{ v.font_medium or v.font_regular }}"); font-weight: 500; }
{% endif %}
{% if v.font_display_file %}
@font-face { font-family: "{{ v.font_display }}"; src: url("{{ assets }}/{{ v.font_display_file }}"); font-weight: 400; }
{% endif %}

:root {
  --serene: {{ v.paper }};
  --ink: {{ v.ink }};
  --ink-2: rgba({{ ink_rgb }},.72);
  --ink-3: rgba({{ ink_rgb }},.48);
  --line: rgba({{ ink_rgb }},.12);
  --azure: {{ v.accent }};
  --surface: {{ v.surface }};
  --overlay: {{ v.overlay or "8,14,22" }};
  --m: 96px;
  --g: 24px;
  --col: 128px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #d9d9d6; font-family: "{{ v.font_family }}", "Montserrat", "Inter", sans-serif; font-weight: 400; color: var(--ink); padding: 40px; display: flex; flex-wrap: wrap; gap: 40px; }

.art { position: relative; width: 1080px; height: {{ 1920 if story else 1350 }}px; overflow: hidden; background: var(--serene); flex: none; }
.pad { position: absolute; inset: 0; padding: {{ '250px var(--m) 320px' if story else 'var(--m)' }}; display: flex; flex-direction: column; }
.dark { color: var(--serene); --ink-2: rgba({{ paper_rgb }},.82); --ink-3: rgba({{ paper_rgb }},.72); --line: rgba({{ paper_rgb }},.22); }

.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(var(--overlay),.62) 0%, rgba(var(--overlay),.18) 26%, rgba(var(--overlay),.50) 60%, rgba(var(--overlay),.88) 100%); }

.top { display: flex; align-items: center; justify-content: space-between; height: 28px; flex: none; }
.logo { height: 24px; width: auto; display: block; }
.micro { font-size: 15px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
.foot { margin-top: auto; padding-top: 28px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 40px; flex: none; }
.progress { display: flex; gap: 6px; flex: none; }
.progress i { display: block; width: 28px; height: 2px; background: var(--line); }
.progress i.on { background: var(--azure); }

.eyebrow { font-size: 16px; letter-spacing: .12em; text-transform: uppercase; color: var(--azure); }
.dark .eyebrow { color: rgba({{ paper_rgb }},.78); }
h1, h2 { text-wrap: balance; }
h1 { font-weight: 400; font-size: 80px; line-height: 1.04; letter-spacing: -.025em; }
h2 { font-weight: 400; font-size: 56px; line-height: 1.08; letter-spacing: -.025em; }
.lead { font-size: 25px; line-height: 1.45; color: var(--ink-2); }
.body { font-size: 22px; line-height: 1.5; color: var(--ink-2); }
.big { font-size: 160px; line-height: .92; letter-spacing: -.04em; color: var(--azure); white-space: nowrap; }
.metric { font-size: 96px; line-height: 1; letter-spacing: -.035em; color: var(--azure); white-space: nowrap; }
.src { font-size: 14px; color: var(--ink-3); }
.rule { border-top: 1px solid var(--line); }
/* Bloco principal centralizado na vertical entre cabeçalho e rodapé (sem vão no meio do slide) */
.stage { margin: auto 0; padding: 32px 0; }
.statement { font-size: 32px; line-height: 1.32; letter-spacing: -.015em; }
{% if v.font_display_file %}
/* Fonte de display nos títulos e números; texto corrido segue na fonte da marca */
h1, h2, .big, .metric, .statement { font-family: "{{ v.font_display }}", "{{ v.font_family }}", sans-serif; letter-spacing: -.01em; }
{% endif %}

.grid { display: grid; grid-template-columns: repeat(6, var(--col)); column-gap: var(--g); }
.c1-3 { grid-column: 1 / 4; } .c4-6 { grid-column: 4 / 7; } .c1-4 { grid-column: 1 / 5; } .c5-6 { grid-column: 5 / 7; }
.c1-2 { grid-column: 1 / 3; } .c3-4 { grid-column: 3 / 5; } .c3-6 { grid-column: 3 / 7; } .c1-5 { grid-column: 1 / 6; } .c1-6 { grid-column: 1 / 7; }

.btn { display: inline-flex; align-items: center; gap: 14px; height: 60px; padding: 0 28px; border: 1px solid currentColor; font-size: 15px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
.tag { display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border: 1px solid currentColor; font-size: 13px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; }
</style>
</head>
<body>
{% set total = slides|length %}
{% macro head(i, dark=false) -%}
  <div class="top">
    <img class="logo" src="{{ assets }}/{{ v.logo_light if dark else v.logo_dark }}" alt="{{ brand_name }}">
    {% if slide_counter %}<span class="micro">{{ '%02d' % (i + 1) }} / {{ '%02d' % total }}</span>{% endif %}
  </div>
{%- endmacro %}
{% macro foot(i, s) -%}
  <div class="foot" style="margin-top: 72px;">
    <span class="src">{{ s.source or '' }}</span>
    {% if slide_counter %}<div class="progress">{% for k in range(total) %}<i{% if k == i %} class="on"{% endif %}></i>{% endfor %}</div>
    {% else %}<span class="micro">{{ site_url }}</span>{% endif %}
  </div>
{%- endmacro %}
{% macro title_block(n, s) -%}
  <p class="eyebrow">{{ '%02d' % n }}{% if s.eyebrow %} · {{ s.eyebrow }}{% endif %}</p>
  <h2 style="margin-top: 20px;">{{ s.title|br }}</h2>
{%- endmacro %}

{% for s in slides %}
{% set i = loop.index0 %}
{% set n = i %}{# conteúdo numerado a partir de 01 (capa é o slide 0) #}

{% if s.layout == 'cover' %}
{% if cover_photo %}
<section class="art" id="slide-{{ '%02d' % (i + 1) }}" data-layout="cover"{% if not photo_cover %} style="background: var(--ink);"{% endif %}>
  {% if photo_cover %}<img class="photo" src="{{ photo_cover }}" alt="">{% endif %}
  <div class="overlay" style="background: linear-gradient(180deg, rgba(var(--overlay),.60) 0%, rgba(var(--overlay),.42) 35%, rgba(var(--overlay),.48) 65%, rgba(var(--overlay),.80) 100%);"></div>
  <div class="pad dark">
{% else %}
{# Capa só com texto: fundo da marca, sem foto nem véu, logo escuro #}
<section class="art" id="slide-{{ '%02d' % (i + 1) }}" data-layout="cover">
  <div class="pad">
{% endif %}
    <div class="top">
      <img class="logo" src="{{ assets }}/{{ v.logo_light if cover_photo else v.logo_dark }}" alt="{{ brand_name }}">
      <span class="micro">{{ kicker }}</span>
    </div>
    <div class="stage">
      {% if s.tag %}<span class="tag">{{ s.tag }}</span>{% endif %}
      {% if s.eyebrow %}<p class="eyebrow" style="margin-top: {{ 40 if s.tag else 0 }}px;">{{ s.eyebrow }}</p>{% endif %}
      <h1 style="margin-top: 20px;">{{ s.title|br }}</h1>
      {% if s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-4">{{ s.lead }}</p></div>{% endif %}
    </div>
    <div class="foot" style="margin-top: 0;">
      <span class="micro">{{ site_url }}</span>
      <span class="micro" style="color: var({{ '--serene' if cover_photo else '--ink' }});">{{ 'Toque para continuar →' if story else 'Arraste →' }}</span>
    </div>
  </div>
</section>

{% elif s.layout == 'cta' %}
<section class="art" id="slide-{{ '%02d' % (i + 1) }}" data-layout="cta"{% if not photo_cta %} style="background: var(--ink);"{% endif %}>
  {% if photo_cta %}<img class="photo" src="{{ photo_cta }}" alt="">{% endif %}
  <div class="overlay" style="background: linear-gradient(180deg, rgba(var(--overlay),.55), rgba(var(--overlay),.35) 40%, rgba(var(--overlay),.90));"></div>
  <div class="pad dark">
    {{ head(i, true) }}
    <div class="stage">
      <p class="eyebrow">{{ s.eyebrow or 'Obrigado por ler até aqui' }}</p>
      <h1 style="margin-top: 20px;">{{ s.title|br }}</h1>
      {% if s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-4">{{ s.lead }}</p></div>{% endif %}
    </div>

    <div>
      <span class="btn">{{ cta_button }}</span>
      <p class="micro" style="margin-top: 20px;">{{ site_url }}</p>
    </div>
    {% set pcols = {2: ['c1-3','c4-6'], 3: ['c1-2','c3-4','c5-6'], 4: ['c1-3','c4-6','c1-3','c4-6']}[pillars|length] %}
    <div class="grid" style="margin-top: {{ 40 if pillars|length == 4 else 56 }}px; row-gap: 20px;">
      {% for name, desc in pillars %}
      <div class="{{ pcols[loop.index0] }} rule" style="padding-top: {{ 16 if pillars|length == 4 else 20 }}px; {{ '' if name == pillar else 'opacity: .62;' }}">
        <p style="font-size: 19px; line-height: 1.3;">{{ name }}</p>
        <p class="body" style="font-size: 16px; line-height: 1.45; margin-top: 8px;">{{ desc }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="foot" style="margin-top: 48px;">
      <span class="micro">{{ footer_tagline }}</span>
      <span class="micro" style="text-transform: none; letter-spacing: .04em;">{{ handle }}</span>
    </div>
  </div>
</section>

{% else %}
<section class="art" id="slide-{{ '%02d' % (i + 1) }}" data-layout="{{ s.layout }}">
  <div class="pad">
    {{ head(i) }}
    <div class="stage">
    {{ title_block(n, s) }}

    {% if s.layout == 'big_number' %}
      {% if s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-5">{{ s.lead }}</p></div>{% endif %}
      <div class="grid rule" style="margin-top: 56px; padding-top: 40px; align-items: end;">
        <span class="big c1-3" data-fit>{{ s.big }}</span>
        <p class="body c4-6" style="padding-bottom: 14px;">{{ s.body or '' }}</p>
      </div>

    {% elif s.layout == 'metrics' %}
      {% set ms = (s.metrics or [])[:3] %}
      {% set cols = ['c1-3','c4-6'] if ms|length == 2 else ['c1-2','c3-4','c5-6'] %}
      {% if s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-5">{{ s.lead }}</p></div>{% endif %}
      <div class="grid" style="margin-top: 56px;">
        {% for m in ms %}
        <div class="{{ cols[loop.index0] }} rule" style="padding-top: 32px;">
          <p class="metric" data-fit style="font-size: {{ 120 if ms|length == 2 else 80 }}px;">{{ m.value }}</p>
          <p class="body" style="margin-top: 20px;">{{ m.label }}</p>
        </div>
        {% endfor %}
      </div>
      {% if s.body %}<div class="grid" style="margin-top: 56px;"><p class="lead c1-4">{{ s.body }}</p></div>{% endif %}

    {% elif s.layout == 'list' %}
      {% if s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-5">{{ s.lead }}</p></div>{% endif %}
      <ol style="list-style: none; margin-top: 56px;">
        {% for it in (s['items'] or [])[:4] %}
        <li class="grid rule" style="padding: 22px 0;">
          <span class="micro" style="grid-column: 1 / 2; color: var(--azure); padding-top: 9px;">{{ '%02d' % loop.index }}</span>
          <div style="grid-column: 2 / 7;">
            <p style="font-size: 28px; line-height: 1.25; letter-spacing: -.02em;">{{ it.title }}</p>
            <p class="body" style="margin-top: 8px; font-size: 19px;">{{ it.text }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
      {% if s.body %}<div class="grid rule" style="padding-top: 22px;"><p class="body" style="grid-column: 2 / 7; font-size: 20px; color: var(--azure);">{{ s.body }}</p></div>{% endif %}

    {% elif s.layout == 'statement' %}
      <div class="grid rule" style="margin-top: 56px; padding-top: 40px;">
        <p class="statement c1-5">{{ s.lead or '' }}</p>
        {% if s.body %}<p class="body c1-4" style="margin-top: 32px;">{{ s.body }}</p>{% endif %}
      </div>

    {% elif s.layout == 'bars' %}
      {% set bs = (s.bars or [])[:6] %}
      {% set mx = (bs | map(attribute='value') | max) if bs else 1 %}
      {% set any_hl = bs | selectattr('highlight') | list | length > 0 %}
      {% if s.big %}
      <div class="grid" style="margin-top: 56px; align-items: end;">
        <span class="big c1-3" data-fit>{{ s.big }}</span>
        <p class="body c4-6" style="padding-bottom: 14px;">{{ s.body or '' }}</p>
      </div>
      {% elif s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-5">{{ s.lead }}</p></div>{% endif %}
      <div class="rule" style="margin-top: 56px; padding-top: 32px;">
        <div style="display:grid; grid-template-columns: repeat({{ bs|length }}, 1fr); column-gap: var(--g); align-items: end; height: 300px;">
          {% for b in bs %}
          {% set on = b.highlight or not any_hl %}
          <div style="display:flex; flex-direction:column; justify-content:flex-end; height:100%;">
            {% if on %}<span style="font-size: 20px; color: var(--azure); margin-bottom: 12px;">{{ b.display }}</span>{% endif %}
            <div style="height: {{ [(b.value / mx * 240)|round|int, 4]|max }}px; background: {{ 'var(--azure)' if b.highlight else 'var(--surface)' }};"></div>
          </div>
          {% endfor %}
        </div>
        <div style="display:grid; grid-template-columns: repeat({{ bs|length }}, 1fr); column-gap: var(--g); margin-top: 12px; border-top: 1px solid var(--line); padding-top: 12px;">
          {% for b in bs %}<span class="src">{{ b.label }}</span>{% endfor %}
        </div>
      </div>

    {% elif s.layout == 'illustration' %}
      {# Ilustração do gpt-image-2 com fundo neutralizado para branco; multiply leva o branco à cor do artboard #}
      <div style="margin-top: 40px;">
        <img src="{{ images.get(i|string, '') }}" alt="" style="display: block; width: 888px; height: {{ 640 if story else 544 }}px; object-fit: contain; mix-blend-mode: multiply;">
      </div>
      {% if s.body %}<div class="grid" style="margin-top: 24px;"><p class="body c1-4">{{ s.body }}</p></div>{% endif %}

    {% elif s.layout == 'line' %}
      {% if s.big %}
      <div class="grid" style="margin-top: 56px; align-items: end;">
        <span class="big c1-3" data-fit>{{ s.big }}</span>
        <p class="body c4-6" style="padding-bottom: 14px;">{{ s.body or '' }}</p>
      </div>
      {% elif s.lead %}<div class="grid" style="margin-top: 28px;"><p class="lead c1-5">{{ s.lead }}</p></div>{% endif %}
      <div class="rule" style="margin-top: 56px; padding-top: 32px;">
        <svg class="line-chart" viewBox="0 0 888 330" width="888" height="330" style="display:block; overflow: visible;"
             data-series='{{ (s.series or [])[:2] | tojson }}'
             data-x='{{ (s.x_labels or []) | tojson }}'></svg>
      </div>
    {% endif %}

    </div>
    {{ foot(i, s) }}
  </div>
</section>
{% endif %}
{% endfor %}

<script>
// Gráfico de linha: até 2 séries, a destacada na cor de acento, rótulo no ponto final.
const css = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
const FONT = "{{ v.font_family }}";
document.querySelectorAll("svg.line-chart").forEach(svg => {
  const series = JSON.parse(svg.dataset.series || "[]");
  const xl = JSON.parse(svg.dataset.x || "[]");
  if (!series.length) return;
  const ns = "http://www.w3.org/2000/svg";
  const W = 720, y0 = 30, y1 = 290;
  const all = series.flatMap(s => s.values);
  const pad = (Math.max(...all) - Math.min(...all)) * 0.08 || 1;
  const min = Math.min(...all) - pad, max = Math.max(...all) + pad;
  const el = (tag, attrs, text) => { const e = document.createElementNS(ns, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (text != null) e.textContent = text; svg.appendChild(e); return e; };
  el("line", { x1: 0, y1: y1, x2: W, y2: y1, stroke: css("--line") });
  const fmt = v => Number.isInteger(v) ? v.toLocaleString("pt-BR") : v.toLocaleString("pt-BR", { maximumFractionDigits: 1 });
  series.forEach(s => {
    const color = s.highlight ? css("--azure") : css("--ink");
    const pts = s.values.map((v, i) => [i * W / Math.max(s.values.length - 1, 1), y1 - (v - min) / (max - min) * (y1 - y0)]);
    el("polyline", { points: pts.map(p => p.join(",")).join(" "), fill: "none", stroke: color, "stroke-width": 2.5, "stroke-linejoin": "round" });
    const [x, y] = pts[pts.length - 1];
    el("rect", { x: x - 4, y: y - 4, width: 8, height: 8, fill: color });
    el("text", { x: x + 18, y: y + 6, "font-size": 18, fill: color, "font-family": FONT }, `${s.name} ${fmt(s.values[s.values.length - 1])}`);
  });
  if (xl[0]) el("text", { x: 0, y: 318, "font-size": 14, fill: css("--ink-3"), "font-family": FONT }, xl[0]);
  if (xl[1]) el("text", { x: W, y: 318, "font-size": 14, fill: css("--ink-3"), "text-anchor": "end", "font-family": FONT }, xl[1]);
});

// Títulos: se o modelo quebrou as linhas ("\n" → <br>) e alguma não cabe, reduz a fonte até cada
// linha caber inteira (sem palavra órfã). Mínimo: 60px no display, 44px no H2.
function fitTitles() {
  document.querySelectorAll("h1, h2").forEach(e => {
    const wanted = e.querySelectorAll("br").length + 1;
    if (wanted < 2) return;
    const min = e.tagName === "H1" ? 60 : 44;
    const lines = () => Math.round(e.getBoundingClientRect().height / parseFloat(getComputedStyle(e).lineHeight));
    let size = parseFloat(getComputedStyle(e).fontSize);
    while (lines() > wanted && size > min) { size -= 2; e.style.fontSize = size + "px"; }
  });
}

// Reduz números grandes até caberem na coluna (sem quebrar o grid).
function fit() {
  fitTitles();
  document.querySelectorAll("[data-fit]").forEach(e => {
    let size = parseFloat(getComputedStyle(e).fontSize);
    while (e.scrollWidth > e.clientWidth + 1 && size > 48) { size -= 4; e.style.fontSize = size + "px"; }
  });
  // Relatório de estouro: conteúdo maior que a área útil do artboard.
  window.__overflow = [...document.querySelectorAll(".art")].filter(a => {
    const pad = a.querySelector(".pad");
    const fits = [...a.querySelectorAll("[data-fit]")].every(e => e.scrollWidth <= e.clientWidth + 1);
    return pad.scrollHeight > pad.clientHeight + 1 || !fits;
  }).map(a => a.id);
  window.__ready = true;
}
document.fonts.ready.then(fit);
</script>
</body>
</html>
