# ---------- Marca ----------
# Pacote em brands/<slug>/ (brand.toml, knowledge/, assets/). Cada empresa = um serviço com seu BRAND.
BRAND=exemplo

# ---------- Telegram ----------
# Crie o bot com @BotFather e cole o token.
TELEGRAM_BOT_TOKEN=
# Chat(s) autorizados, separados por vírgula (pessoal e/ou grupo). O PRIMEIRO recebe o ciclo semanal.
# Mande /start ao bot (no privado ou no grupo) para descobrir o ID; ID de grupo começa com -100.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- OpenAI (ChatGPT) ----------
OPENAI_API_KEY=
# Modelo principal (pesquisa, escrita) e modelo rápido (classificar mensagens). Luna: o mais barato da linha GPT-6.
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_FAST=gpt-6-luna
# low | medium | high. Deixe vazio se o modelo escolhido não aceitar o parâmetro.
OPENAI_REASONING_EFFORT=medium
# library = fotos nórdicas de assets/photos · generate = gera fotos com o modelo de imagem
PHOTO_SOURCE=library
OPENAI_IMAGE_MODEL=gpt-image-2
# Slide de ilustração/diagrama de todo post (ChatGPT Images 2)
OPENAI_ILLUSTRATION_MODEL=gpt-image-2
OPENAI_ILLUSTRATION_QUALITY=high

# ---------- Apify (tendências: Google Trends, Reddit, X) ----------
# Fontes e termos em apify_sources.json. Sem token, o agente usa só HN, Google News e web search.
APIFY_TOKEN=

# ---------- Publicação ----------
# buffer (padrão; API inclusa no plano gratuito) | metricool (exige plano pago com API)
PUBLISHER=buffer
PUBLISH_NETWORKS=instagram,linkedin
PUBLISH_STORIES=true
# Stories por post. 0 = todos: os mesmos slides do feed, na mesma ordem, em formato 9:16.
# Um número limita aos principais (capa, ilustração, 1º dado, CTA...).
STORY_FRAMES=0
# Posts agendados por canal que o plano do Buffer comporta (Free = 10). O agente confere a fila
# antes de agendar e não publica pela metade. "Postar agora" não usa a fila. 0 = não conferir.
BUFFER_QUEUE_LIMIT=10
# document = carrossel em PDF no LinkedIn (formato nativo) | images = várias imagens
LINKEDIN_FORMAT=document

# ---------- Buffer ----------
# Chave em https://publish.buffer.com/settings/api . Conecte Instagram (conta profissional) e
# LinkedIn (página da empresa) no Buffer; os canais são encontrados automaticamente.
BUFFER_API_KEY=
# Opcional: fixar canais se houver mais de um Instagram/LinkedIn conectado
# BUFFER_INSTAGRAM_CHANNEL_ID=
# BUFFER_LINKEDIN_CHANNEL_ID=

# ---------- Metricool (alternativa) ----------
# METRICOOL_USER_TOKEN=
# METRICOOL_USER_ID=
# METRICOOL_BLOG_ID=
# Horários do botão "Agendar no próximo horário" (MON TUE WED THU FRI SAT SUN)
POST_SLOTS=TUE 10:00,THU 10:00

# ---------- Storage público das imagens (Supabase Storage) ----------
# O Buffer baixa as imagens de uma URL pública e estável. Crie um bucket público com este nome.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=social-agent

# ---------- Agenda ----------
TIMEZONE=America/Sao_Paulo
# 0 = segunda ... 6 = domingo
WEEKLY_DAY=0
WEEKLY_TIME=09:00

# ---------- Caminhos ----------
# Base de conhecimento da marca (padrão: brands/<slug>/knowledge). Pode apontar para uma pasta
# maior da empresa para o agente consultar mais documentos.
# KNOWLEDGE_ROOT=
# Estado (SQLite, renders de trabalho, log). Padrão: ~/.agent-socialmedia/<slug>. Fora do Drive de propósito.
# DATA_DIR=
# Onde as peças aprovadas são arquivadas (padrão: DATA_DIR/_social)
# ARCHIVE_DIR=

# Opcional: sobrescrevem site e @ do brand.toml
# SITE_URL=
# INSTAGRAM_HANDLE=
